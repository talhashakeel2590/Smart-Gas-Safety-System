<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_main"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="Logout"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/card_bg"
            app:cornerRadius="100dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ Admin Dashboard"
            android:textAlignment="center"
            android:textColor="@color/text_main"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Monitoring all users"
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- Shown when there are no users yet -->
        <TextView
            android:id="@+id/tvNoUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="32dp"
            android:text="No users registered yet."
            android:textAlignment="center"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- One card per user is added here by AdminActivity -->
        <LinearLayout
            android:id="@+id/llUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>