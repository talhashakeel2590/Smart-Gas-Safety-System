<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginBottom="24dp"
            android:text="📱 AI-Driven IoT"
            android:textAlignment="center"
            android:textColor="@color/text_main"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- System Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System Status"
                    android:textColor="@color/text_main"/>
                <TextView
                    android:id="@+id/tvSysStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NORMAL"
                    android:textColor="@color/accent_green"
                    android:textSize="36sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvSysStatusDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ No hazards detected"
                    android:textColor="@color/text_muted"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Gas Gauge Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="308dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="30dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/gasGauge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="1000"
                        app:indicatorColor="@color/accent_blue"
                        app:indicatorSize="180dp"
                        app:trackColor="@color/border_color"
                        app:trackThickness="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGasPpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/text_main"
                            android:textSize="48sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PPM"
                            android:textColor="@color/text_muted"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvRiskScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/border_color"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="AI Risk: "
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRiskScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#34A853"
                            android:textSize="16sp"
                            android:textStyle="bold" /> <!-- Starts Green -->

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Flame Status Split Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="#1AFFFFFF"
                    android:gravity="center"
                    android:text="🔥"
                    android:textSize="24sp"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="91dp"
                        android:layout_height="24dp"
                        android:text="Flame Status"
                        android:textColor="@color/text_main" />
                    <TextView
                        android:id="@+id/tvFlameStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLEAR"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnEmergencyShutoff"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/accent_red"
            android:text="🔔 EMERGENCY SHUTOFF"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="100dp" />

        <Button
            android:id="@+id/btnResetSystem"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1A22C55E"
            android:text="↺ SYSTEM RESET"
            android:textColor="@color/accent_green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="100dp"
            app:strokeColor="@color/accent_green"
            app:strokeWidth="1dp" />

        <!-- NEW: View History Button -->
        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/card_bg"
            android:text="📜 VIEW LEAK HISTORY"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="100dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>